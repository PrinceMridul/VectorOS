# ─────────────────────────────────────────────────────────────────────────────
# VectorOS — environment configuration
# Copy to `.env` and fill in. Every value below has a working default,
# so `make dev` runs with ZERO configuration (mock LLM + SQLite).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
VECTOROS_ENV=development                 # development | staging | production
VECTOROS_SECRET_KEY=dev-secret-change-me # REQUIRED to be changed in production
VECTOROS_LOG_LEVEL=INFO
VECTOROS_CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Laptop default (no infrastructure required):
VECTOROS_DATABASE_URL=sqlite+aiosqlite:///./vectoros.db
#
# Postgres / Supabase (enables pgvector ANN search):
# VECTOROS_DATABASE_URL=postgresql+asyncpg://vectoros:vectoros@localhost:5432/vectoros
# VECTOROS_DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# ── AI provider layer ────────────────────────────────────────────────────────
# `mock` runs the entire pedagogical loop offline and deterministically.
# Set to gemini | openai | anthropic once you have a key.
VECTOROS_LLM_PROVIDER=mock

# Per-capability-tier model routing. Agents request a tier, never a model name.
VECTOROS_MODEL_FAST=gemini-2.5-flash-lite
VECTOROS_MODEL_BALANCED=gemini-2.5-flash
VECTOROS_MODEL_DEEP=claude-sonnet-5

# Keys (only the provider you select is required)
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings
VECTOROS_EMBEDDING_PROVIDER=mock          # mock | gemini | openai
VECTOROS_EMBEDDING_MODEL=text-embedding-004
VECTOROS_EMBEDDING_DIM=768

# ── Pedagogy tuning ──────────────────────────────────────────────────────────
# These are product decisions, not magic numbers. See ARCHITECTURE.md §5.
VECTOROS_MASTERY_THRESHOLD=0.85           # unlock gate on the prerequisite DAG
VECTOROS_ZPD_TARGET_LOW=0.50              # desirable-difficulty band, lower bound
VECTOROS_ZPD_TARGET_HIGH=0.80             # upper bound
VECTOROS_STRUGGLE_FLOOR_SECONDS=45        # min think time before guidance unlocks
VECTOROS_OFFLOAD_LOCK_THRESHOLD=3         # answer-demands before free text locks
VECTOROS_MASTERY_HALF_LIFE_DAYS=14        # forgetting curve time constant

# ── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
